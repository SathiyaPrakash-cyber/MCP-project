# Template for the local .env used by docker-compose.
#
# Do NOT copy this file as-is: the placeholder values below are not secrets.
# Run ./scripts/bootstrap_env.sh to generate a .env with random credentials.

# JWT signing key. Must be at least 32 characters. The gateway refuses to start
# on an empty, short, or publicly known value.
JWT_SECRET=replace-me-with-a-random-48-character-value

# Guards the mock MCP server's /admin/mutate_tool and /admin/reset_tools routes,
# which exist only so the rug-pull experiment can change a tool at runtime.
MOCK_ADMIN_TOKEN=replace-me-with-a-random-48-character-value

# Acknowledges the single-host experimental stack described in docker-compose.yml.
MCP_GATEWAY_LAB_MODE=1

# Deny all tool calls unless a tool-schema baseline was sealed at startup.
SCHEMA_PIN_REQUIRED=1

# Interface the gateway's port 8080 is published on.
GATEWAY_BIND=127.0.0.1

# Comma-separated browser origins permitted to call the gateway.
CORS_ALLOW_ORIGINS=http://localhost:8080
